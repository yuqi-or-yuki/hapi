# Dependencies
**/node_modules/

# Build output
**/dist/
**/.vitepress/cache/
**/dist-exe/
**/*.tsbuildinfo
hub/src/web/embeddedAssets.generated.ts
hub/src/generated/

# Downloaded tools (fetched at build time)
shared/tools/tunwg/tunwg-*
shared/tools/tunwg/*.exe

# Env files (can contain secrets)
**/.env
**/.env.*
**/.env*.local

# Logs
**/*.log
**/*-debug.log
**/*-error.log
npm-debug.log*

# Coverage
coverage/

# OS / IDE
**/.DS_Store
.idea/
.vscode/
**/*.swp
**/*.swo

# Claude local settings
.claude/settings.local.json
localdocs/
execplan/

# Generated npm bundle output (local)
cli/npm/main/
.ace-tool/

# Playwright e2e artifacts
test-results/
playwright-report/
e2e-output/
.xyz-harness
.agents/
.pi/
ecosystem.config.cjs

# Local runtime artifacts (fork-local, never committed)
.claude/worktrees/
.hapi-debates/
hub/hapi.db
hub/hapi.db-*
hub/tools/
